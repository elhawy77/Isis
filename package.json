{
  "name": "isis-ai-video-generator",
  "version": "1.0.0",
  "description": "Advanced AI Video & Image Generation Platform - Text to Video, Image to Video, Multi-modal Generation",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mongoose": "^7.5.0",
    "axios": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "aws-sdk": "^2.1500.0",
    "redis": "^4.6.10",
    "socket.io": "^4.7.2",
    "bull": "^4.11.3",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "stripe": "^13.6.0",
    "node-fetch": "^2.7.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1"
  }
}
