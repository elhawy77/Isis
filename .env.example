# AI Video Generator - Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/isis-video-gen

# Redis for Job Queue
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here

# ============ RUNWAY ML API ============
RUNWAY_API_KEY=your_runway_api_key
RUNWAY_API_URL=https://api.runwayml.com/v1

# ============ LUMA AI API ============
LUMA_API_KEY=your_luma_api_key
LUMA_API_URL=https://api.lumaai.net

# ============ STABLE VIDEO DIFFUSION ============
STABLE_VIDEO_API_KEY=your_stable_video_key
STABLE_VIDEO_URL=https://api.stability.ai/v2

# ============ REPLICATE API (for open-source models) ============
REPLICATE_API_TOKEN=your_replicate_token

# ============ AWS S3 (for storing videos/images) ============
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=isis-videos
AWS_REGION=us-east-1

# ============ Stripe Payment ============
STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_PUBLIC_KEY=your_stripe_public

# ============ FFmpeg Configuration ============
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ============ Processing Configuration ============
MAX_VIDEO_DURATION=120
MAX_RESOLUTION=4096x2160
PROCESSING_TIMEOUT=600000
TEMP_DIR=/tmp/isis-videos
OUTPUT_DIR=/output/videos

# ============ Frontend ============
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Isis - AI Video Generator
